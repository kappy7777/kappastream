{
  "semi": false,
  "singleQuote": true,
  "printWidth": 120,
  "trailingComma": "all",
  "plugins": [
    "prettier-plugin-svelte"
  ],
  "svelteSortOrder": "scripts-markup-options-styles",
  "overrides": [
    {
      "files": "*.svelte",
      "options": {
        "parser": "svelte"
      }
    }
  ]
}
