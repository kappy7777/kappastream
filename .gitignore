# Local secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Tauri updater signing keys (tauri signer generate). The PRIVATE key
# (*.key) is the one-way secret: losing it strands every shipped install.
# Defense-in-depth in case `tauri signer generate -w` is ever pointed at a
# repo-relative path. (Default output ~/.tauri/ is outside the repo anyway.)
*.tauri.key
*.tauri.key.pub
tauri-*.key

# Agent instruction files — kept local, not for public release
AGENTS.md
agents.md
AGENTS-notes.md
agents-notes.md

# Windows bundled-streamlink staging (release.yml build-windows; shipped as
# bundle resources via tauri.windows.conf.json)
streamlink-bundle/

# AppImage bundled-lib staging (scripts/stage-appimage-libs.sh output,
# shipped via bundle.linux.appimage.files — build-host bytes, never committed)
src-tauri/appimage-staging/
